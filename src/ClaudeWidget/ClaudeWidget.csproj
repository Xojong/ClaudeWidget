<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>ClaudeWidget</AssemblyName>
    <RootNamespace>ClaudeWidget</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Version>1.0.0</Version>
    <!-- WFO0003 tells WinForms apps to move DPI config out of the manifest. This
         is a WPF app; the manifest declaration is the correct mechanism here. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms is enabled only to reuse NotifyIcon. Its implicit global usings
         make Brush/Point/MenuItem/ContextMenu ambiguous against their WPF
         counterparts, so drop them — the two places that need WinForms types
         reference them through the Forms/Drawing aliases instead. -->
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

</Project>
